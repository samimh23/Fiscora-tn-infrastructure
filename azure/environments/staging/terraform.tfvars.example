# NEW DEPLOYMENT TEMPLATE ONLY. Never overwrite an existing terraform.tfvars.
# No passwords/API keys here: use the Key Vault setup scripts.
# Routine settings use the unchanged defaults in variables.tf.

# 1. Account-specific settings: replace all placeholders before planning.
azure_subscription_id    = "00000000-0000-0000-0000-000000000000"
operator_object_id       = "00000000-0000-0000-0000-000000000000"
deployment_suffix        = "change123" # Unique lowercase suffix; keep stable once deployed.
budget_contact_emails    = ["you@example.com"]
azure_gcp_wif_app_id_uri = "api://YOUR-TENANT-ID/fiscora-google-wif"

# GitHub numeric IDs identify the repositories allowed to deploy through OIDC.
# Default names: samimh23 / Fiscora-tn-backend / Fiscora-tn-web.
# Override the owner/repository names too when using different repositories.
github_owner_id                 = "REPLACE-WITH-NUMERIC-OWNER-ID"
github_backend_repository_id    = "REPLACE-WITH-NUMERIC-BACKEND-ID"
github_frontend_repository_id    = "REPLACE-WITH-NUMERIC-FRONTEND-ID"

# 2. First deployment: prepare the platform before starting the API.
# Existing API deployments MUST retain true and their current image reference.
deploy_application = false
backend_image      = "" # Later: registry/repository@sha256:... from the backend build.
smtp_user          = "REPLACE-WITH-BREVO-SMTP-LOGIN" # Not the SMTP secret.

# 3. Optional features: uncomment after their prerequisites are ready.
# Domains: configure Namecheap DNS before enabling Azure custom-domain bindings.
# enable_custom_domains = true
# Google sign-in: public OAuth client ID, not a secret.
# google_oauth_client_id = "YOUR-CLIENT-ID.apps.googleusercontent.com"

# Extraction: deploy the separate GCP stack and configure WIF before enabling.
# document_extraction_enabled  = true
# document_extraction_provider = "nuextract"
# qwen_service_url             = "https://YOUR-QWEN-SERVICE.a.run.app"
# nuextract_service_url        = "https://YOUR-NUEXTRACT-SERVICE.a.run.app"
# paddle_ocr_service_url       = "https://YOUR-PADDLEOCR-SERVICE.a.run.app"
# gcp_wif_provider_audience    = "//iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/fiscora-azure/providers/azure-container-apps"
# gcp_wif_service_account      = "fiscora-azure-api@YOUR-GCP-PROJECT.iam.gserviceaccount.com"
# gcp_project_id               = "YOUR-GCP-PROJECT"
# Assistant: enable after the RAG migration and Vertex IAM permissions are ready.
# ai_assistant_enabled = true

# 4. Advanced overrides: defaults are documented in variables.tf.
# location                = "francecentral"
# static_web_app_location = "eastus2"
# postgres_version        = "16"
# postgres_sku_name       = "B_Standard_B1ms"
# malware_scan_enabled    = true
# frontend_public_url     = "https://app.fiscora.me"
# For NEW deployments, set budget dates to valid month boundaries when needed.
