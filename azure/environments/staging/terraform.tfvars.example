azure_subscription_id  = "00000000-0000-0000-0000-000000000000"
operator_object_id      = "00000000-0000-0000-0000-000000000000"
location                = "francecentral"
static_web_app_location = "eastus2"
project_name            = "fiscora"
environment             = "staging"
deployment_suffix       = "sami090"

budget_amount_usd     = 40
budget_start_date     = "2026-09-01T00:00:00Z"
budget_end_date       = "2027-01-01T00:00:00Z"
budget_contact_emails = ["samimahjoub090@gmail.com"]

github_owner                     = "samimh23"
github_owner_id                  = "80358238"
github_infrastructure_repository = "Fiscora-tn-infrastructure"
github_backend_repository        = "Fiscora-tn-backend"
github_backend_repository_id     = "1312797097"
github_frontend_repository       = "Fiscora-tn-web"
github_frontend_repository_id    = "1312796835"

postgres_sku_name = "B_Standard_B1ms"
postgres_version  = "16"

# First apply: leave false. Populate Key Vault and push the backend image.
deploy_application = false
backend_image       = ""

frontend_public_url       = "https://app.fiscora.me"
smtp_host                 = "smtp-relay.brevo.com"
smtp_port                 = 587
smtp_user                 = "REPLACE-WITH-BREVO-SMTP-LOGIN"
smtp_from                 = "Fiscora <invitations@fiscora.me>"
malware_scan_enabled      = true
clamav_image              = "clamav/clamav:1.4"
enable_custom_domains     = false
frontend_custom_domain    = "app.fiscora.me"

# Enable only after the GCP workload identity pool has been applied.
document_extraction_enabled = false
nuextract_service_url       = "https://fiscora-nuextract-xxxxxxxxxx-ew.a.run.app"
azure_gcp_wif_app_id_uri    = "api://TENANT_ID/fiscora-google-wif"
gcp_wif_provider_audience   = "//iam.googleapis.com/projects/PROJECT_NUMBER/locations/global/workloadIdentityPools/fiscora-azure/providers/azure-container-apps"
gcp_wif_service_account     = "fiscora-azure-api@fiscora-ai.iam.gserviceaccount.com"

# Enable after the RAG migration and Vertex IAM binding are deployed.
ai_assistant_enabled      = false
gcp_project_id            = "fiscora-ai"
vertex_ai_location        = "global"
vertex_ai_chat_model      = "gemini-2.5-flash"
vertex_ai_embedding_model = "gemini-embedding-001"
ai_assistant_max_vector_distance = "0.8"
