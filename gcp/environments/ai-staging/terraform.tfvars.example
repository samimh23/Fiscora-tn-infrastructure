# NEW DEPLOYMENT TEMPLATE ONLY. Never replace an existing terraform.tfvars.
# One Google configuration; stable technical defaults stay in variables.tf.
project_id         = "YOUR-GCP-PROJECT"
billing_account_id = "000000-000000-000000"

invoker_members = [
  "user:you@example.com",
]

# Build with scripts/deploy-ai.ps1. Paste each digest before enabling its service.
# NuExtract3 is the only extraction model for invoices and statements.
enable_nuextract_service      = false
nuextract_image               = null

# Build with build-paddleocr.ps1, paste its immutable digest, then enable.
enable_ocr_service = false
ocr_image          = null

azure_tenant_id                     = "00000000-0000-0000-0000-000000000000"
azure_managed_identity_object_id    = "00000000-0000-0000-0000-000000000000"
azure_application_id_uri            = "api://TENANT_ID/fiscora-google-wif"

# Optional overrides: region, budget, service names and concurrency are in
# variables.tf. Existing deployments must retain their actual overrides.
